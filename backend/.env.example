# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control!
# ==============================================================================

# Server Port (Render sets this dynamically via process.env.PORT, default is 5000 or 10000)
PORT=5000

# Environment Mode ('development' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# MONGODB ATLAS CONNECTION STRING INSTRUCTIONS
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
#
# CRITICAL: If your MongoDB Atlas password contains special characters, they MUST be URL-encoded:
#   @  ->  %40
#   #  ->  %23
#   :  ->  %3A
#   /  ->  %2F
#   ?  ->  %3F
#   %  ->  %25
#   !  ->  %21
#   $  ->  %24
#   &  ->  %26
#   +  ->  %2B
#   =  ->  %3D
#
# Example with password "P@ss#123":
#   mongodb+srv://alumni_admin:P%40ss%23123@cluster0.abcde.mongodb.net/alm_db?retryWrites=true&w=majority
#
# For Local MongoDB:
#   MONGO_URI=mongodb://localhost:27017/alm_db
# ------------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<encoded_password>@cluster0.xxxxxx.mongodb.net/alm_db?retryWrites=true&w=majority

# JWT Authentication
# In production, use a strong 64-character random string (e.g., openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_change_in_production_12345!
JWT_EXPIRE=7d

# Frontend Client URL for CORS
# In production, set this to your Vercel deployment URL (e.g., https://your-alm-app.vercel.app)
CLIENT_URL=http://localhost:4200
